+#ifdef CHIMERA_CORE
+/* The Next's Multiface: 8 KiB of ROM at 0x014000 and 8 KiB of RAM at
+ * 0x016000 of its memory (ZEsarUX's multiface_enable knows them), paged in
+ * at 0x0000-0x3FFF by its NMI, with the enable and disable ports of the
+ * type register 0x0A bits 7:6 chooses (0x3F and 0xBF for the +3 type, the
+ * Next's default). */
+int chimera_tbblue_multiface_nmi=0;
+
+void tbblue_generate_multiface_nmi(void)
+{
+    if (!multiface_enabled.v) multiface_enable();
+    switch ((tbblue_registers[10]>>6)&3) {
+        case 0: multiface_type=MULTIFACE_TYPE_THREE; break;
+        case 1: multiface_type=MULTIFACE_TYPE_128; break;
+        /* 10 = Multiface 128 v87.12 and 11 = Multiface 1: both page in
+         * with port 0x9F and out with 0x1F, ZEsarUX's Multiface 1 ports */
+        default: multiface_type=MULTIFACE_TYPE_ONE; break;
+    }
+    chimera_tbblue_multiface_nmi=1;
+    generate_nmi();
+}
+#endif
