+#ifdef CHIMERA_CORE
+#include "mem128.h"
+/* ROM3 of the machine the Next is set to is what 0x0000-0x3FFF shows */
+static int chimera_tbblue_rom3_paged(void)
+{
+    if (tbblue_registers[0x50]!=255 || tbblue_registers[0x51]!=255) return 0;
+    switch (tbblue_registers[3]&7) {
+        case 1: return 1;
+        case 3:
+            if (puerto_8189&1) return 0;
+            return ( ((puerto_8189>>1)&2) | ((puerto_32765>>4)&1) )==3;
+        default: return (puerto_32765>>4)&1;
+    }
+}
+#endif
