{
 "coreName": "ZEsarUX",
 "systemId": "ZXN",
 "systemNames": {
  "ZXN": "ZX Spectrum Next"
 },
 "author": "Cesar Hernandez Bano and the ZEsarUX contributors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-zesarux",
 "romFile": "rom",
 "deterministic": true,
 "suggestSettings": true,
 "memoryLayoutMiB": [
  64,
  4,
  8,
  4,
  1280
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The Next has 2 MiB of memory; its SD card is held whole in the core's memory, read before the machine is sealed, so a savestate carries only what the machine wrote to it. The mmap arena has room for a card of up to 1 GiB (the System/Next card for emulators) beside ZEsarUX's own tables; a bigger card is refused (cinterface.c, CARD_MAX_BYTES).",
 "video": {
  "_comment": "The Next's display, with its border, as ZEsarUX draws it: every dot of the Next's finest mode (640 across) is one dot here, so the Spectrum's 256x192 screen is drawn twice as wide and twice as high. A Next draws 50 frames a second here; ZEsarUX does not make the Next's 60 Hz mode.",
  "width": 704,
  "height": 608,
  "virtualWidth": 811,
  "virtualHeight": 608,
  "vsyncNumerator": 50,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "ZEsarUX mixes the beeper, the three sound chips and the DACs into one stereo sample for each of the 312 lines of a frame: 15600 samples a second.",
  "rate": 15600,
  "samplesPerFrame": 1024,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "extensions": {
  ".nex": "ZXN",
  ".snx": "ZXN",
  ".mmc": "ZXN"
 },
 "input": {
  "name": "ZX Spectrum Next Keyboard and Joystick",
  "_comment": "The forty keys of a Spectrum's keyboard, row by row as they are printed (the Next's other keys - the cursor keys, EDIT, BREAK, DELETE and the rest - are pressed as the Spectrum pressed them, with CAPS SHIFT and a number); the Reset and Hard Reset buttons (a soft reset, and a reset that starts the boot ROM again); and a joystick of four directions and two fire buttons. What the joystick is (Kempston, Sinclair, cursor or a Mega Drive pad) is the Next's own setting, chosen by its programs.",
  "buttons": [
   "Keyboard 1",
   "Keyboard 2",
   "Keyboard 3",
   "Keyboard 4",
